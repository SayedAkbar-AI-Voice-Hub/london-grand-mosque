# Local development: no env vars needed — uses local SQLite file
# Production on Vercel: set these in Vercel dashboard

# Turso (edge SQLite) — get from https://turso.tech
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN="your-turso-token"

# JWT secret (optional, defaults to a dev secret)
JWT_SECRET="your-secret-key-change-this"
